{
  "name": "otter-fpga-toolkit",
  "displayName": "Otter FPGA Toolkit - 水獭FPGA工具集",
  "description": "小水獭的FPGA开发利器：一键例化、代码排版、iverilog/xvlog语法检查、高亮、跳转、补全",
  "icon": "icon.png",
  "version": "2.1.12",
  "publisher": "Otter-xiaoxiaoxuwang",
  "repository": {
    "type": "git",
    "url": "https://github.com/lingshuncangqiong/otter-fpga-toolkit"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test",
    "check": "node --check extension.js && node --test"
  },
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog",
    "onLanguage:sdc",
    "onLanguage:xdc",
    "onLanguage:cst"
  ],
  "contributes": {
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sdc",
        "aliases": [
          "SDC",
          "sdc"
        ],
        "extensions": [
          ".sdc"
        ]
      },
      {
        "id": "xdc",
        "aliases": [
          "XDC",
          "xdc"
        ],
        "extensions": [
          ".xdc"
        ]
      },
      {
        "id": "cst",
        "aliases": [
          "CST",
          "cst"
        ],
        "extensions": [
          ".cst"
        ]
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
      {
        "language": "sdc",
        "scopeName": "source.sdc",
        "path": "./syntaxes/sdc.tmLanguage.json"
      },
      {
        "language": "xdc",
        "scopeName": "source.xdc",
        "path": "./syntaxes/xdc.tmLanguage.json"
      },
      {
        "language": "cst",
        "scopeName": "source.cst",
        "path": "./syntaxes/cst.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "verilog-instantiate.generateInstance",
        "title": "Verilog: 生成例化模板",
        "enablement": "editorLangId == verilog || editorLangId == systemverilog"
      },
      {
        "command": "verilog-instantiate.xvlogLint",
        "title": "Verilog: xvlog 检查当前文件",
        "enablement": "editorLangId == verilog || editorLangId == systemverilog"
      },
      {
        "command": "verilog-instantiate.alignCode",
        "title": "Verilog: 排版格式化",
        "enablement": "editorLangId == verilog || editorLangId == systemverilog"
      },
      {
        "command": "verilog-instantiate.showHierarchy",
        "title": "Verilog: 显示当前模块层次",
        "icon": "$(type-hierarchy)",
        "enablement": "editorLangId == verilog || editorLangId == systemverilog"
      },
      {
        "command": "verilog-instantiate.refreshHierarchy",
        "title": "Verilog: 刷新模块层次",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "verilog-instantiate.generateInstance",
        "key": "ctrl+shift+i",
        "when": "editorLangId == verilog || editorLangId == systemverilog"
      },
      {
        "command": "verilog-instantiate.generateInstance",
        "key": "ctrl+1",
        "when": "editorLangId == verilog || editorLangId == systemverilog"
      },
      {
        "command": "verilog-instantiate.generateInstance",
        "key": "ctrl+numpad1",
        "when": "editorLangId == verilog || editorLangId == systemverilog"
      },
      {
        "command": "verilog-instantiate.alignCode",
        "key": "ctrl+l",
        "when": "editorLangId == verilog || editorLangId == systemverilog"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "otterFpgaPanel",
          "title": "Otter FPGA",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "otterFpgaPanel": [
        {
          "id": "otterFpgaHierarchy",
          "name": "模块层次"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "otterFpgaHierarchy",
        "contents": "当前编辑器没有可显示的 Verilog/SystemVerilog module。\n[刷新模块层次](command:verilog-instantiate.refreshHierarchy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "verilog-instantiate.showHierarchy",
          "when": "resourceLangId == verilog || resourceLangId == systemverilog",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "verilog-instantiate.refreshHierarchy",
          "when": "view == otterFpgaHierarchy",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Otter FPGA Toolkit",
      "properties": {
        "verilogInstantiate.tabSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 4,
          "description": "缩进空格数 (例化模板 / 排版共用)"
        },
        "verilogInstantiate.lintTool": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "xvlog", "iverilog", "modelsim"],
          "enumDescriptions": ["自动 (优先 iverilog)", "Vivado xvlog", "Icarus Verilog (iverilog)", "ModelSim/Questa (vlog)"],
          "description": "语法检查工具"
        },
        "verilogInstantiate.xvlogPath": {
          "type": "string",
          "default": "xvlog",
          "description": "xvlog 路径 (如 D:/Xilinx/Vivado/2024.2/bin/xvlog.bat)"
        },
        "verilogInstantiate.autoLintOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存文件时自动运行语法检查"
        },
        "verilogInstantiate.lintOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "打开 Verilog/SystemVerilog 文件时自动运行语法检查"
        },
        "verilogInstantiate.lintOnActiveEditorChange": {
          "type": "boolean",
          "default": false,
          "description": "切换到 Verilog/SystemVerilog 编辑器时自动运行语法检查"
        },
        "verilogInstantiate.enableCompletion": {
          "type": "boolean",
          "default": true,
          "description": "启用代码补全 (module/always/case/fsm 等)"
        },
        "verilogInstantiate.enablePortDirectionHints": {
          "type": "boolean",
          "default": true,
          "description": "在 named port connection 前显示 input/output/inout 内联提示"
        },
        "verilogInstantiate.workspaceIndexMaxFiles": {
          "type": "integer",
          "minimum": 100,
          "maximum": 50000,
          "default": 5000,
          "description": "跨文件跳转、端口方向提示和模块层次树最多索引的 RTL 文件数"
        },
        "verilogInstantiate.workspaceIndexMaxFileSizeKB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 102400,
          "default": 2048,
          "description": "工作区索引允许的单个 RTL 文件最大大小（KB）；已打开文档不受此限制"
        },
        "verilogInstantiate.workspaceIndexExclude": {
          "type": "string",
          "default": "**/{.git,node_modules,.Xil,.xil,xsim.dir,work,*.gen,*.cache,*.ip_user_files,*.runs}/**",
          "description": "工作区 RTL 索引排除 glob；默认跳过 Git/Node/Vivado 生成目录"
        },
        "verilogInstantiate.iverilogIgnoreMissingModule": {
          "type": "boolean",
          "default": true,
          "description": "iverilog 忽略 找不到模块 错误 (单文件开发时例化的外部模块必然找不到)"
        },
        "verilogInstantiate.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "头文件搜索路径（如 D:/my_project/include）。用于独立文件语法检查时指定 include 文件所在目录。留空时自动向上搜索 3 层找 inc/rtl/src/include 目录"
        }
      }
    }
  },
  "configurationDefaults": {
    "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
          "scope": "entity.name.tag.instance",
          "settings": {
            "foreground": "#569CD6",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "entity.name.type.instance",
          "settings": {
            "foreground": "#6A9955"
          }
        },
        {
          "scope": "variable.other.readwrite",
          "settings": {
            "foreground": "#D8A0D8"
          }
        }
      ]
    }
  },
  "devDependencies": {
    "jimp": "^1.6.1"
  }
}
